<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SchoesMarket.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converters="using:SchoesMarket.Converters"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:SchoesMarket"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SchoesMarket.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1000"
        Height="600"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        Icon="/Assets/Icon.ico"
        Title="Главная">


    <Window.Resources>
        <converters:DiscountToColorConverter x:Key="DiscountToColorConverter" /> 
    </Window.Resources>


    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>
    

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
        <Border Padding="10">
            <StackPanel Spacing="10">
		        <TextBlock Text="Товары" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Авторизация" Command="{Binding OpenAuthCommand}"/>
                </StackPanel>
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                               <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
            
                        <ItemsControl.ItemTemplate>
                               <DataTemplate>
                            <!-- Используем наш UserControl -->
                                <views:ProductCard DataContext="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
             </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
